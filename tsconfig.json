{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "resolveJsonModule": true,
    "sourceMap": true, "declaration": true
  },
  "include": ["src/**/*.ts"]
}
